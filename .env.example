# Copy to .env before running `docker compose up`. Never commit the real
# .env file (it's gitignored) or these values to source control.

# SQL Server 'sa' password used by the sqlserver, api, and web services.
SQL_SA_PASSWORD=YourStrong!Passw0rd

# Password for every seeded demo user (admin, therapist, scheduler, biller,
# tm.admin, tm.therapist). Required -- the api service refuses to start
# without it. See DemoDataSeeder and README.md#demo-data.
SEED_DEMO_PASSWORD=DemoPass123!
