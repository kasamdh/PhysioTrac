{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\MSSQLLocalDB;Database=PhysioTrac;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "App": {
    "FrontendBaseUrl": "http://localhost:5173"
  },
  "Security": {
    "FailedLoginLockoutThreshold": 5,
    "LockoutDurationMinutes": 15,
    "IdleTimeoutMinutes": 15,
    "AbsoluteSessionHours": 12,
    "SessionLimitsByRole": {
      "SuperAdmin": 1,
      "Admin": 1,
      "Biller": 1,
      "Scheduler": 1,
      "Director": 2,
      "Therapist": 2,
      "Assistant": 2,
      "Compliance": 2,
      "Patient": 3
    }
  }
}
