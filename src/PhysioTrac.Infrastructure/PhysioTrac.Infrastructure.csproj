<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PhysioTrac.Domain\PhysioTrac.Domain.csproj" />
    <ProjectReference Include="..\PhysioTrac.Application\PhysioTrac.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Needed for IHttpContextAccessor (ClaimsCurrentUser) — Infrastructure
         isn't a web project itself, so this isn't implicit like it is for
         Sdk.Web projects (Api, Web). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.10" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pinned above Microsoft.Data.SqlClient's own transitive versions,
         which carry known advisories (GHSA-wvxc-855f-jvrv, GHSA-m5vv-6r4h-3vj9,
         GHSA-x674-v45j-fwxw, GHSA-447r-wph3-92pm); see the CI dependency-scan
         job and the security docs for details. -->
    <PackageReference Include="Azure.Identity" Version="1.11.4" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.61.3" />
    <PackageReference Include="System.Formats.Asn1" Version="8.0.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
