@inherits LayoutComponentBase
@inject PhysioTrac.Infrastructure.Identity.CurrentUserAccessor CurrentUserAccessor

<AuthorizeView>
    <Authorized>
        <div class="min-h-screen bg-surface-muted">
            <header class="flex flex-wrap items-center gap-4 border-b border-border bg-surface px-6 py-3 shadow-sm">
                <a href="/" class="flex items-center gap-2 text-text no-underline">
                    <span class="flex h-8 w-8 items-center justify-center rounded-md bg-primary text-sm font-bold text-white">P</span>
                    <span class="font-semibold">PhysioTrac</span>
                </a>
                <nav class="flex flex-1 flex-wrap gap-1 text-sm">
                    @{ var navClass = "rounded-md px-3 py-1.5 text-text-muted no-underline transition hover:bg-surface-muted hover:text-text"; }
                    @{ var navActiveClass = "bg-primary-light text-primary-deep font-medium"; }
                    <NavLink href="/patients" class="@navClass" ActiveClass="@navActiveClass">Patients</NavLink>
                    <NavLink href="/schedule" class="@navClass" ActiveClass="@navActiveClass">Schedule</NavLink>
                    <NavLink href="/providers" class="@navClass" ActiveClass="@navActiveClass">Providers</NavLink>
                    <NavLink href="/appointment-types" class="@navClass" ActiveClass="@navActiveClass">Appointment types</NavLink>
                    <NavLink href="/service-prices" class="@navClass" ActiveClass="@navActiveClass">Service prices</NavLink>
                    <NavLink href="/payers" class="@navClass" ActiveClass="@navActiveClass">Payers</NavLink>
                </nav>
                <div class="flex items-center gap-3 text-sm text-text-muted">
                    <span>@context.User.Identity?.Name</span>
                    <form method="post" action="/account/logout">
                        <button type="submit" class="rounded-md border border-border px-3 py-1.5 text-text-muted transition hover:border-primary hover:text-primary">
                            Sign out
                        </button>
                    </form>
                </div>
            </header>
            <main class="mx-auto max-w-6xl px-6 py-6">
                @Body
            </main>
        </div>
    </Authorized>
</AuthorizeView>

<div id="blazor-error-ui" class="fixed inset-x-0 bottom-0 bg-danger px-4 py-3 text-sm text-white">
    An unhandled error has occurred.
    <a href="" class="reload underline">Reload</a>
    <a class="dismiss ml-2 cursor-pointer">✕</a>
</div>

@code {
    [CascadingParameter]
    private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var authState = await AuthStateTask;
            // Set once per circuit so ICurrentUser (via ClaimsCurrentUser)
            // resolves correctly for services invoked later by interaction,
            // when IHttpContextAccessor.HttpContext is no longer reliable.
            CurrentUserAccessor.Principal = authState.User;
        }
    }
}
