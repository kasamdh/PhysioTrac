@page "/claims/{ClaimId:guid}"
@attribute [Authorize]
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using PhysioTrac.Application.Auth
@using PhysioTrac.Application.Billing
@using PhysioTrac.Application.Tenancy
@using PhysioTrac.Domain.Entities
@using PhysioTrac.Domain.Enums
@using PhysioTrac.Infrastructure.Persistence
@inject ICurrentUser CurrentUser
@inject IClaimService ClaimService
@inject IClaimTransactionService TransactionService
@inject PhysioTracDbContext Db

<PageTitle>Claim — PhysioTrac</PageTitle>

@if (_error is not null)
{
    <p class="alert-error">@_error</p>
}
else if (_claim is null)
{
    <p class="text-text-muted">Loading…</p>
}
else
{
    <a href="/patients/@_claim.PatientId" class="text-sm text-text-muted no-underline hover:text-primary">&larr; Back to patient</a>

    <div class="card mt-3">
        <div class="flex flex-wrap items-center justify-between gap-2">
            <h1 class="text-xl font-semibold text-text">Claim — @PayerName</h1>
            @if (!CanManage)
            {
                <StatusPill Text="@_claim.Status.ToString()" />
            }
        </div>
        <div class="mt-2 flex flex-wrap items-center gap-2 text-sm text-text-muted">
            @if (CanManage)
            {
                <span>Status:</span>
                <select @bind="_statusChange" class="field-input mt-0 w-auto">
                    @foreach (var status in Enum.GetValues<ClaimStatus>())
                    {
                        <option value="@status">@status</option>
                    }
                </select>
                <button class="btn-secondary" @onclick="UpdateStatus">Update</button>
            }
            @if (_claim.SubmittedAt is not null)
            {
                <span> · Submitted @_claim.SubmittedAt?.ToString("yyyy-MM-dd")</span>
            }
            @if (_claim.ClosedAt is not null)
            {
                <span> · Closed @_claim.ClosedAt?.ToString("yyyy-MM-dd")</span>
            }
        </div>
        @if (_statusError is not null)
        {
            <p class="alert-error mt-2">@_statusError</p>
        }

        <p class="mt-3 text-sm text-text-muted">Diagnosis codes: @(_claim.DiagnosisCodeList.Count > 0 ? string.Join(", ", _claim.DiagnosisCodeList) : "—")</p>

        @if (_totals is not null)
        {
            <div class="mt-4 flex flex-wrap gap-3">
                <div class="rounded-lg border border-border bg-surface-muted px-4 py-2.5">
                    <span class="block text-xs text-text-subtle">Total charges</span>
                    <strong class="text-text">@_totals.TotalChargeAmount.ToString("C")</strong>
                </div>
                <div class="rounded-lg border border-border bg-surface-muted px-4 py-2.5">
                    <span class="block text-xs text-text-subtle">Total paid</span>
                    <strong class="text-text">@_totals.TotalPaid.ToString("C")</strong>
                </div>
                <div class="rounded-lg border border-border bg-surface-muted px-4 py-2.5">
                    <span class="block text-xs text-text-subtle">Total adjusted</span>
                    <strong class="text-text">@_totals.TotalAdjusted.ToString("C")</strong>
                </div>
                <div class="rounded-lg border border-border bg-surface-muted px-4 py-2.5">
                    <span class="block text-xs text-text-subtle">Balance</span>
                    <strong class="text-text">@_totals.Balance.ToString("C")</strong>
                </div>
            </div>
        }
    </div>

    <div class="card mt-4">
        <h3 class="section-title">Charges on this claim</h3>
        @if (_charges.Count == 0)
        {
            <p class="text-text-muted">No charges attached.</p>
        }
        else
        {
            <div class="overflow-hidden rounded-lg border border-border">
                <table class="data-table">
                    <thead><tr><th>Service date</th><th>CPT</th><th>Units</th><th>Amount</th></tr></thead>
                    <tbody>
                        @foreach (var charge in _charges)
                        {
                            <tr>
                                <td>@charge.ServiceDate.ToString("yyyy-MM-dd")</td>
                                <td>@charge.CptCode</td>
                                <td>@charge.Units</td>
                                <td>@charge.ChargeAmount.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="card mt-4">
        <h3 class="section-title">Transactions</h3>
        @if (CanManage)
        {
            <button class="btn-primary mb-3" @onclick="() => _showTransactionForm = !_showTransactionForm">@(_showTransactionForm ? "Cancel" : "Record transaction")</button>
            @if (_showTransactionForm)
            {
                <div class="mb-4 max-w-md rounded-lg border border-border bg-surface-muted p-4">
                    @if (_transactionError is not null)
                    {
                        <p class="alert-error mb-3">@_transactionError</p>
                    }
                    <label class="field-label">
                        Kind
                        <select @bind="_newTransactionKind" class="field-input">
                            @foreach (var kind in Enum.GetValues<ClaimTransactionKind>())
                            {
                                <option value="@kind">@kind</option>
                            }
                        </select>
                    </label>
                    @if (_newTransactionKind is ClaimTransactionKind.InsurancePayment or ClaimTransactionKind.PatientPayment)
                    {
                        <label class="field-label">
                            Method
                            <select @bind="_newTransactionMethod" class="field-input">
                                <option value="">Unspecified</option>
                                @foreach (var method in Enum.GetValues<ClaimTransactionMethod>())
                                {
                                    <option value="@method">@method</option>
                                }
                            </select>
                        </label>
                    }
                    <label class="field-label">Amount <input type="number" min="0.01" step="0.01" @bind="_newTransactionAmount" class="field-input" /></label>
                    <label class="field-label">Payment date <input type="date" @bind="_newTransactionDate" class="field-input" /></label>
                    <label class="field-label">Reference (optional) <input @bind="_newTransactionReference" class="field-input" /></label>
                    @if (_newTransactionKind == ClaimTransactionKind.Transfer)
                    {
                        <label class="field-label">
                            Transfer to claim
                            <select @bind="_newTransactionTransferToClaimId" class="field-input">
                                <option value="">Select claim…</option>
                                @foreach (var claim in _siblingClaims)
                                {
                                    <option value="@claim.Id">@claim.Id (@claim.Status)</option>
                                }
                            </select>
                        </label>
                    }
                    <label class="field-label">Denial code (optional) <input @bind="_newTransactionDenialCode" class="field-input" /></label>
                    <label class="field-label">Denial reason (optional) <input @bind="_newTransactionDenialReason" class="field-input" /></label>
                    <label class="field-label">Notes (optional) <input @bind="_newTransactionNotes" class="field-input" /></label>
                    <button class="btn-primary" @onclick="RecordTransaction">Save</button>
                </div>
            }
        }
        @if (_transactions.Count == 0)
        {
            <p class="text-text-muted">No transactions recorded.</p>
        }
        else
        {
            <div class="overflow-hidden rounded-lg border border-border">
                <table class="data-table">
                    <thead><tr><th>Date</th><th>Kind</th><th>Method</th><th>Amount</th><th>Reference</th></tr></thead>
                    <tbody>
                        @foreach (var transaction in _transactions)
                        {
                            <tr>
                                <td>@transaction.PaymentDate.ToString("yyyy-MM-dd")</td>
                                <td>@transaction.Kind</td>
                                <td>@(transaction.Method?.ToString() ?? "—")</td>
                                <td>@transaction.Amount.ToString("C")</td>
                                <td>@(transaction.Reference ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@code {
    [Parameter]
    public Guid ClaimId { get; set; }

    private Claim? _claim;
    private string? _error;
    private ClaimTotalsDto? _totals;
    private List<Charge> _charges = new();
    private List<ClaimTransaction> _transactions = new();
    private List<Claim> _siblingClaims = new();
    private string PayerName => _payerName ?? "Unknown payer";
    private string? _payerName;

    private ClaimStatus _statusChange;
    private string? _statusError;

    private bool _showTransactionForm;
    private string? _transactionError;
    private ClaimTransactionKind _newTransactionKind = ClaimTransactionKind.InsurancePayment;
    private ClaimTransactionMethod? _newTransactionMethod;
    private decimal _newTransactionAmount;
    private DateOnly _newTransactionDate = DateOnly.FromDateTime(DateTime.Today);
    private string? _newTransactionReference;
    private Guid? _newTransactionTransferToClaimId;
    private string? _newTransactionDenialCode;
    private string? _newTransactionDenialReason;
    private string? _newTransactionNotes;

    private bool CanManage => RoleSets.Billing.Contains(CurrentUser.Role);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _claim = await ClaimService.GetAsync(ClaimId, CurrentUser);
            _totals = await ClaimService.GetTotalsAsync(ClaimId, CurrentUser);
        }
        catch (Exception ex) when (ex is PhysioTrac.Application.Common.ForbiddenException or PhysioTrac.Application.Common.NotFoundException)
        {
            _error = ex.Message;
            return;
        }

        _statusChange = _claim.Status;
        var payer = await Db.Payers.FirstOrDefaultAsync(p => p.Id == _claim.PayerId);
        _payerName = payer?.Name;

        _charges = await Db.Charges.Where(c => c.ClaimId == _claim.Id).OrderBy(c => c.ServiceDate).ToListAsync();
        _transactions = (await TransactionService.ListForClaimAsync(ClaimId, CurrentUser)).ToList();
        _siblingClaims = await Db.Claims.Where(c => c.PatientId == _claim.PatientId && c.Id != _claim.Id).ToListAsync();
    }

    private async Task UpdateStatus()
    {
        _statusError = null;
        try
        {
            await ClaimService.UpdateStatusAsync(ClaimId, new UpdateClaimStatusRequest(_statusChange), CurrentUser);
        }
        catch (PhysioTrac.Application.Common.ForbiddenException ex) { _statusError = ex.Message; return; }
        await LoadAsync();
    }

    private async Task RecordTransaction()
    {
        _transactionError = null;
        if (_newTransactionAmount <= 0)
        {
            _transactionError = "Amount must be greater than zero.";
            return;
        }
        if (_newTransactionKind == ClaimTransactionKind.Transfer && _newTransactionTransferToClaimId is null)
        {
            _transactionError = "Select a destination claim for the transfer.";
            return;
        }

        var request = new RecordClaimTransactionRequest(
            _claim!.PatientId, ClaimId, _newTransactionTransferToClaimId, _newTransactionKind, _newTransactionMethod,
            _newTransactionAmount, _newTransactionDate,
            string.IsNullOrWhiteSpace(_newTransactionReference) ? null : _newTransactionReference.Trim(),
            string.IsNullOrWhiteSpace(_newTransactionDenialCode) ? null : _newTransactionDenialCode.Trim(),
            string.IsNullOrWhiteSpace(_newTransactionDenialReason) ? null : _newTransactionDenialReason.Trim(),
            string.IsNullOrWhiteSpace(_newTransactionNotes) ? null : _newTransactionNotes.Trim());

        try
        {
            await TransactionService.RecordAsync(request, CurrentUser);
        }
        catch (Exception ex) when (ex is PhysioTrac.Application.Common.ForbiddenException
            or PhysioTrac.Application.Common.NotFoundException or InvalidOperationException)
        {
            _transactionError = ex.Message;
            return;
        }

        _newTransactionAmount = 0;
        _newTransactionReference = null;
        _newTransactionTransferToClaimId = null;
        _newTransactionDenialCode = null;
        _newTransactionDenialReason = null;
        _newTransactionNotes = null;
        _showTransactionForm = false;
        await LoadAsync();
    }
}
