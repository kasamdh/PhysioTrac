@page "/service-prices"
@attribute [Authorize]
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using PhysioTrac.Application.Auth
@using PhysioTrac.Application.Tenancy
@using PhysioTrac.Domain.Entities
@using PhysioTrac.Domain.Enums
@using PhysioTrac.Infrastructure.Persistence
@inject ICurrentUser CurrentUser
@inject ITenantAccessService TenantAccess
@inject PhysioTracDbContext Db

<PageTitle>Service prices — PhysioTrac</PageTitle>

<h1 class="mb-4 text-xl font-semibold text-text">Service prices</h1>

@if (_error is not null)
{
    <p class="alert-error">@_error</p>
}
else if (_prices is null)
{
    <p class="text-text-muted">Loading…</p>
}
else
{
    <div class="card">
        @if (CanManage)
        {
            <button class="btn-primary mb-4" @onclick="() => _showForm = !_showForm">@(_showForm ? "Cancel" : "New price")</button>

            @if (_showForm)
            {
                <div class="mb-4 max-w-md rounded-lg border border-border bg-surface-muted p-4">
                    @if (_formError is not null)
                    {
                        <p class="alert-error mb-3">@_formError</p>
                    }
                    <label class="field-label">CPT code <input @bind="_cptCode" maxlength="10" class="field-input" /></label>
                    <label class="field-label">Label <input @bind="_label" class="field-input" /></label>
                    <label class="field-label">Price <input type="number" min="0" step="0.01" @bind="_price" class="field-input" /></label>
                    <label class="field-label">
                        Home-visit kind (optional)
                        <select @bind="_homeVisitKind" class="field-input">
                            <option value="">None</option>
                            @foreach (var kind in Enum.GetValues<AppointmentKind>())
                            {
                                <option value="@kind">@kind</option>
                            }
                        </select>
                    </label>
                    <label class="mb-3 flex items-center gap-2 text-sm">
                        <input type="checkbox" @bind="_isHomeVisitTravelFee" />
                        This is the home-visit travel fee
                    </label>
                    <label class="field-label">Deposit amount (home-visit kind only, optional) <input type="number" min="0" step="0.01" @bind="_depositAmount" class="field-input" /></label>
                    <button class="btn-primary" @onclick="CreatePrice">Save</button>
                </div>
            }
        }

        @if (_prices.Count == 0)
        {
            <p class="text-text-muted">No service prices yet.</p>
        }
        else
        {
            <div class="overflow-hidden rounded-lg border border-border">
                <table class="data-table">
                    <thead>
                        <tr><th>CPT code</th><th>Label</th><th>Price</th><th>Home-visit kind</th><th>Travel fee</th><th>Deposit</th><th>Active</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var price in _prices)
                        {
                            <tr>
                                <td>@price.CptCode</td>
                                <td>@price.Label</td>
                                <td>@price.Price.ToString("C")</td>
                                <td>@(price.HomeVisitKind?.ToString() ?? "—")</td>
                                <td>@(price.IsHomeVisitTravelFee ? "Yes" : "No")</td>
                                <td>@(price.DepositAmount is { } d ? d.ToString("C") : "—")</td>
                                <td><StatusPill Text="@(price.IsActive ? "Active" : "Inactive")" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@code {
    private List<ServicePrice>? _prices;
    private string? _error;
    private string? _formError;
    private bool _showForm;
    private Guid _organizationId;

    private string _cptCode = string.Empty;
    private string _label = string.Empty;
    private decimal _price;
    private AppointmentKind? _homeVisitKind;
    private bool _isHomeVisitTravelFee;
    private decimal? _depositAmount;

    private bool CanManage => RoleSets.Billing.Contains(CurrentUser.Role);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            var organization = await TenantAccess.OrganizationRequiredAsync(CurrentUser);
            _organizationId = organization.Id;
            _prices = await Db.ServicePrices.Where(s => s.OrganizationId == organization.Id)
                .OrderBy(s => s.CptCode).ToListAsync();
        }
        catch (PhysioTrac.Application.Common.ForbiddenException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task CreatePrice()
    {
        _formError = null;
        try
        {
            TenantAccess.RequireRole(CurrentUser, RoleSets.Billing);
        }
        catch (PhysioTrac.Application.Common.ForbiddenException ex)
        {
            _formError = ex.Message;
            return;
        }

        if (string.IsNullOrWhiteSpace(_cptCode) || string.IsNullOrWhiteSpace(_label))
        {
            _formError = "CPT code and label are required.";
            return;
        }
        if (_homeVisitKind is not null && _isHomeVisitTravelFee)
        {
            _formError = "A price row can be tagged as a home-visit kind or the travel fee, not both.";
            return;
        }
        if (_depositAmount is decimal deposit)
        {
            if (_isHomeVisitTravelFee || _homeVisitKind is null)
            {
                _formError = "A deposit can only be set on a home-visit-kind price.";
                return;
            }
            if (deposit <= 0)
            {
                _formError = "Enter a deposit amount greater than zero.";
                return;
            }
        }

        var price = new ServicePrice
        {
            OrganizationId = _organizationId,
            CptCode = _cptCode.Trim(),
            Label = _label.Trim(),
            Price = _price,
            HomeVisitKind = _homeVisitKind,
            IsHomeVisitTravelFee = _isHomeVisitTravelFee,
            DepositAmount = _depositAmount,
            CreatedById = CurrentUser.UserId,
        };
        Db.ServicePrices.Add(price);
        await Db.SaveChangesAsync();

        _cptCode = string.Empty;
        _label = string.Empty;
        _price = 0;
        _homeVisitKind = null;
        _isHomeVisitTravelFee = false;
        _depositAmount = null;
        _showForm = false;
        await LoadAsync();
    }
}
