@page "/login"
@layout PhysioTrac.Web.Components.Layout.EmptyLayout
@attribute [AllowAnonymous]

<PageTitle>Sign in — PhysioTrac</PageTitle>

<div class="flex min-h-screen items-center justify-center bg-surface-muted px-4">
    <div class="w-full max-w-sm rounded-xl border border-border bg-surface p-8 shadow-sm">
        <div class="mb-6 text-center">
            <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-lg bg-primary text-xl font-bold text-white">
                P
            </div>
            <h1 class="text-lg font-semibold text-text">PhysioTrac</h1>
            <p class="mt-1 text-sm text-text-muted">Source Motion Physical Therapy</p>
        </div>

        @if (HasError)
        {
            <p class="mb-4 rounded-md bg-danger-light px-3 py-2 text-sm text-danger">Invalid username or password.</p>
        }

        <form method="post" action="/account/login" class="space-y-4">
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />
            <label class="block text-sm font-medium text-text-muted">
                Username
                <input type="text" name="username" autocomplete="username" required
                       class="mt-1 w-full rounded-md border border-border px-3 py-2 text-sm text-text focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" />
            </label>
            <label class="block text-sm font-medium text-text-muted">
                Password
                <input type="password" name="password" autocomplete="current-password" required
                       class="mt-1 w-full rounded-md border border-border px-3 py-2 text-sm text-text focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" />
            </label>
            <button type="submit"
                    class="w-full rounded-md bg-primary px-4 py-2 text-sm font-semibold text-white transition hover:bg-primary-deep">
                Sign in
            </button>
        </form>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    private bool HasError => Error == "1";
}
