@page "/patients/{PatientId:guid}"
@attribute [Authorize]
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using PhysioTrac.Application.Auth
@using PhysioTrac.Application.Billing
@using PhysioTrac.Application.Clinical
@using PhysioTrac.Application.Tenancy
@using PhysioTrac.Domain.Entities
@using PhysioTrac.Domain.Enums
@using PhysioTrac.Infrastructure.Persistence
@inject ICurrentUser CurrentUser
@inject ITenantAccessService TenantAccess
@inject IClinicalNoteService NoteService
@inject IFunctionalGoalService GoalService
@inject IOutcomeScoreService OutcomeService
@inject IChargeService ChargeService
@inject IClaimService ClaimServiceApi
@inject PhysioTracDbContext Db
@inject NavigationManager Navigation

<PageTitle>@(_patient?.FullName ?? "Patient") — PhysioTrac</PageTitle>

<a href="/patients">&larr; Back to patients</a>

@if (_error is not null)
{
    <p class="error">@_error</p>
}
else if (_patient is null)
{
    <p>Loading…</p>
}
else
{
    <h1>@_patient.FullName</h1>
    <dl>
        <dt>MRN</dt>
        <dd>@_patient.MedicalRecordNumber</dd>
        <dt>Date of birth</dt>
        <dd>@_patient.DateOfBirth.ToString("yyyy-MM-dd") (age @_patient.Age)</dd>
        <dt>Status</dt>
        <dd>@_patient.Status</dd>
        <dt>Phone</dt>
        <dd>@(_patient.Phone ?? "—")</dd>
        <dt>Email</dt>
        <dd>@(_patient.Email ?? "—")</dd>
    </dl>

    <section>
        <h2>Clinical notes</h2>
        @if (CanDocument)
        {
            <div class="inline-form">
                <select @bind="_newNoteType">
                    @foreach (var type in Enum.GetValues<NoteType>())
                    {
                        <option value="@type">@type</option>
                    }
                </select>
                <input type="date" @bind="_newNoteServiceDate" />
                <button class="primary" @onclick="StartNote">Start note</button>
            </div>
            @if (_noteError is not null)
            {
                <p class="error">@_noteError</p>
            }
        }
        @if (_notes is null)
        {
            <p>Loading…</p>
        }
        else if (_notes.Count == 0)
        {
            <p>No clinical notes yet.</p>
        }
        else
        {
            <table>
                <thead>
                    <tr><th>Service date</th><th>Type</th><th>Status</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var note in _notes)
                    {
                        <tr>
                            <td>@note.ServiceDate.ToString("yyyy-MM-dd")</td>
                            <td>@note.NoteType</td>
                            <td>@note.Status</td>
                            <td><a href="/notes/@note.Id">Open</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <section>
        <h2>Functional goals</h2>
        @if (CanDocument)
        {
            <button class="primary" @onclick="() => _showGoalForm = !_showGoalForm">@(_showGoalForm ? "Cancel" : "New goal")</button>
            @if (_showGoalForm)
            {
                <div class="form-card">
                    @if (_goalError is not null)
                    {
                        <p class="error">@_goalError</p>
                    }
                    <label>Functional limitation <input @bind="_newGoalLimitation" /></label>
                    <label>Functional task <input @bind="_newGoalTask" /></label>
                    <label>Baseline value <input type="number" step="0.01" @bind="_newGoalBaseline" /></label>
                    <label>Target value <input type="number" step="0.01" @bind="_newGoalTarget" /></label>
                    <label>Unit <input @bind="_newGoalUnit" placeholder="e.g. degrees, reps" /></label>
                    <label>Measurement method <input @bind="_newGoalMethod" /></label>
                    <label>Target date <input type="date" @bind="_newGoalTargetDate" /></label>
                    <button class="primary" @onclick="CreateGoal">Save</button>
                </div>
            }
        }
        @if (_goals is null)
        {
            <p>Loading…</p>
        }
        else if (_goals.Count == 0)
        {
            <p>No functional goals yet.</p>
        }
        else
        {
            <table>
                <thead>
                    <tr><th>Limitation</th><th>Task</th><th>Baseline → Target</th><th>Current</th><th>Progress</th><th>Status</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var goal in _goals)
                    {
                        <tr>
                            <td>@goal.FunctionalLimitation</td>
                            <td>@goal.FunctionalTask</td>
                            <td>@goal.BaselineValue → @goal.TargetValue @goal.Unit</td>
                            <td>
                                @if (goal.Status == GoalStatus.Active)
                                {
                                    <input type="number" step="0.01" style="width:5rem"
                                           value="@GoalProgressInput(goal.Id, goal.CurrentValue)"
                                           @onchange="e => _goalProgressEdits[goal.Id] = e.Value?.ToString()" />
                                    <button @onclick="() => UpdateGoalProgress(goal.Id)">Save</button>
                                }
                                else
                                {
                                    @(goal.CurrentValue?.ToString() ?? "—")
                                }
                            </td>
                            <td>@(goal.ProgressPercent is { } p ? $"{p}%" : "—")</td>
                            <td>@goal.Status</td>
                            <td>
                                @if (goal.Status == GoalStatus.Draft && CanApproveGoals)
                                {
                                    <button @onclick="() => ApproveGoal(goal.Id)">Approve</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <section>
        <h2>Outcome measures</h2>
        @if (CanDocument)
        {
            <button class="primary" @onclick="() => _showOutcomeForm = !_showOutcomeForm">@(_showOutcomeForm ? "Cancel" : "Record score")</button>
            @if (_showOutcomeForm)
            {
                <div class="form-card">
                    @if (_outcomeError is not null)
                    {
                        <p class="error">@_outcomeError</p>
                    }
                    <label>
                        Measure
                        <select @bind="_newOutcomeMeasure">
                            @foreach (var measure in Enum.GetValues<OutcomeMeasure>())
                            {
                                <option value="@measure">@measure</option>
                            }
                        </select>
                    </label>
                    <label>Measured on <input type="date" @bind="_newOutcomeDate" /></label>
                    <label>Score <input type="number" step="0.01" @bind="_newOutcomeScore" /></label>
                    <label>Maximum score (optional) <input type="number" step="0.01" @bind="_newOutcomeMax" /></label>
                    <button class="primary" @onclick="RecordOutcome">Save</button>
                </div>
            }
        }
        @if (_outcomes is null)
        {
            <p>Loading…</p>
        }
        else if (_outcomes.Count == 0)
        {
            <p>No outcome scores yet.</p>
        }
        else
        {
            <table>
                <thead>
                    <tr><th>Measure</th><th>Measured on</th><th>Score</th></tr>
                </thead>
                <tbody>
                    @foreach (var outcome in _outcomes)
                    {
                        <tr>
                            <td>@outcome.Measure</td>
                            <td>@outcome.MeasuredOn.ToString("yyyy-MM-dd")</td>
                            <td>@outcome.Score@(outcome.MaximumScore is { } max ? $" / {max}" : "")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <section>
        <h2>Insurance</h2>
        @if (CanBill)
        {
            <button class="primary" @onclick="() => _showInsuranceForm = !_showInsuranceForm">@(_showInsuranceForm ? "Cancel" : "Add policy")</button>
            @if (_showInsuranceForm)
            {
                <div class="form-card">
                    @if (_insuranceError is not null)
                    {
                        <p class="error">@_insuranceError</p>
                    }
                    <label>
                        Payer
                        <select @bind="_newInsurancePayerId">
                            <option value="">Select payer…</option>
                            @foreach (var payer in _payerOptions)
                            {
                                <option value="@payer.Id">@payer.Name</option>
                            }
                        </select>
                    </label>
                    <label>
                        Rank
                        <select @bind="_newInsuranceRank">
                            @foreach (var rank in Enum.GetValues<InsuranceRank>())
                            {
                                <option value="@rank">@rank</option>
                            }
                        </select>
                    </label>
                    <label>Member ID <input @bind="_newInsuranceMemberId" /></label>
                    <label>Group number (optional) <input @bind="_newInsuranceGroupNumber" /></label>
                    <label>Effective date <input type="date" @bind="_newInsuranceEffectiveDate" /></label>
                    <label>Termination date (optional) <input type="date" @bind="_newInsuranceTerminationDate" /></label>
                    <label>Copay (optional) <input type="number" min="0" step="0.01" @bind="_newInsuranceCopay" /></label>
                    <button class="primary" @onclick="CreateInsurance">Save</button>
                </div>
            }
        }
        @if (_insurancePolicies is null)
        {
            <p>Loading…</p>
        }
        else if (_insurancePolicies.Count == 0)
        {
            <p>No insurance policies on file.</p>
        }
        else
        {
            <table>
                <thead><tr><th>Payer</th><th>Rank</th><th>Member ID</th><th>Effective</th><th>Termination</th><th>Active</th></tr></thead>
                <tbody>
                    @foreach (var policy in _insurancePolicies)
                    {
                        <tr>
                            <td>@PayerName(policy.PayerId)</td>
                            <td>@policy.Rank</td>
                            <td>@policy.MemberId</td>
                            <td>@policy.EffectiveDate.ToString("yyyy-MM-dd")</td>
                            <td>@(policy.TerminationDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                            <td>@(policy.IsActive ? "Yes" : "No")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <section>
        <h2>Charges</h2>
        @if (CanBill)
        {
            <button class="primary" @onclick="ToggleChargeForm">@(_showChargeForm ? "Cancel" : "New charge")</button>
            @if (_showChargeForm)
            {
                <div class="form-card">
                    @if (_chargeError is not null)
                    {
                        <p class="error">@_chargeError</p>
                    }
                    <label>CPT code <input @bind="_newChargeCptCode" maxlength="5" placeholder="e.g. 97110" /></label>
                    <label>
                        Rendering provider
                        <select @bind="_newChargeProviderId">
                            <option value="">Select provider…</option>
                            @foreach (var provider in _providerOptions)
                            {
                                <option value="@provider.Id">@provider.FullName</option>
                            }
                        </select>
                    </label>
                    <label>
                        Linked note (optional)
                        <select @bind="_newChargeNoteId">
                            <option value="">None</option>
                            @if (_notes is not null)
                            {
                                @foreach (var note in _notes)
                                {
                                    <option value="@note.Id">@note.NoteType - @note.ServiceDate.ToString("yyyy-MM-dd")</option>
                                }
                            }
                        </select>
                    </label>
                    <label>Service date <input type="date" @bind="_newChargeServiceDate" /></label>
                    <label>Units <input type="number" min="1" @bind="_newChargeUnits" /></label>
                    <label>Minutes documented (optional) <input type="number" min="0" @bind="_newChargeMinutes" /></label>
                    <label>Units override reason (required if units differ from the 8-minute-rule recommendation) <input @bind="_newChargeOverrideReason" /></label>
                    <label>Charge amount <input type="number" min="0" step="0.01" @bind="_newChargeAmount" /></label>
                    <button class="primary" @onclick="CreateCharge">Save</button>
                </div>
            }
        }
        @if (_charges is null)
        {
            <p>Loading…</p>
        }
        else if (_charges.Count == 0)
        {
            <p>No charges yet.</p>
        }
        else
        {
            <table>
                <thead><tr><th>Service date</th><th>CPT</th><th>Units</th><th>Amount</th><th>Status</th></tr></thead>
                <tbody>
                    @foreach (var charge in _charges)
                    {
                        <tr>
                            <td>@charge.ServiceDate.ToString("yyyy-MM-dd")</td>
                            <td>@charge.CptCode</td>
                            <td>@charge.Units</td>
                            <td>@charge.ChargeAmount.ToString("C")</td>
                            <td>@charge.Status</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <section>
        <h2>Insurance claims</h2>
        @if (CanBill)
        {
            <button class="primary" @onclick="ToggleClaimForm">@(_showClaimForm ? "Cancel" : "New claim")</button>
            @if (_showClaimForm)
            {
                <div class="form-card">
                    @if (_claimError is not null)
                    {
                        <p class="error">@_claimError</p>
                    }
                    <label>
                        Insurance policy
                        <select @bind="_newClaimInsuranceId">
                            <option value="">Select policy…</option>
                            @if (_insurancePolicies is not null)
                            {
                                @foreach (var policy in _insurancePolicies)
                                {
                                    <option value="@policy.Id">@PayerName(policy.PayerId) - @policy.MemberId (@policy.Rank)</option>
                                }
                            }
                        </select>
                    </label>
                    <label>Unbilled charges</label>
                    @if (UnbilledCharges.Count == 0)
                    {
                        <p>No unbilled charges available to attach.</p>
                    }
                    else
                    {
                        @foreach (var charge in UnbilledCharges)
                        {
                            <label class="checkbox">
                                <input type="checkbox" checked="@_selectedChargeIds.Contains(charge.Id)"
                                       @onchange="e => ToggleChargeSelection(charge.Id, (bool)e.Value!)" />
                                @charge.ServiceDate.ToString("yyyy-MM-dd") — @charge.CptCode — @charge.ChargeAmount.ToString("C")
                            </label>
                        }
                    }
                    <button class="primary" @onclick="CreateClaim">Create claim</button>
                </div>
            }
        }
        @if (_claims is null)
        {
            <p>Loading…</p>
        }
        else if (_claims.Count == 0)
        {
            <p>No insurance claims yet.</p>
        }
        else
        {
            <table>
                <thead><tr><th>Payer</th><th>Status</th><th>Submitted</th><th></th></tr></thead>
                <tbody>
                    @foreach (var claim in _claims)
                    {
                        <tr>
                            <td>@PayerName(claim.PayerId)</td>
                            <td>@claim.Status</td>
                            <td>@(claim.SubmittedAt?.ToString("yyyy-MM-dd") ?? "—")</td>
                            <td><a href="/claims/@claim.Id">Open</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <section>
        <h2>Payments collected</h2>
        @if (CanCollectPayments)
        {
            <button class="primary" @onclick="() => _showPaymentForm = !_showPaymentForm">@(_showPaymentForm ? "Cancel" : "Record payment")</button>
            @if (_showPaymentForm)
            {
                <div class="form-card">
                    @if (_paymentError is not null)
                    {
                        <p class="error">@_paymentError</p>
                    }
                    <label>Amount <input type="number" min="0.01" step="0.01" @bind="_newPaymentAmount" /></label>
                    <label>Received on <input type="date" @bind="_newPaymentReceivedOn" /></label>
                    <label>Reference <input @bind="_newPaymentReference" placeholder="Check #, receipt #, etc." /></label>
                    @if (_superbills is { Count: > 0 })
                    {
                        <label>
                            Apply to superbill (optional)
                            <select @bind="_newPaymentSuperbillId">
                                <option value="">None</option>
                                @foreach (var superbill in _superbills)
                                {
                                    <option value="@superbill.Id">@superbill.ServiceDate.ToString("yyyy-MM-dd") — @superbill.Amount.ToString("C")</option>
                                }
                            </select>
                        </label>
                    }
                    <button class="primary" @onclick="CreatePaymentRecord">Save</button>
                </div>
            }
        }
        @if (_paymentRecords is null)
        {
            <p>Loading…</p>
        }
        else if (_paymentRecords.Count == 0)
        {
            <p>No payments recorded yet.</p>
        }
        else
        {
            <table>
                <thead><tr><th>Received</th><th>Amount</th><th>Reference</th><th>Status</th></tr></thead>
                <tbody>
                    @foreach (var payment in _paymentRecords)
                    {
                        <tr>
                            <td>@payment.ReceivedOn.ToString("yyyy-MM-dd")</td>
                            <td>@payment.Amount.ToString("C")</td>
                            <td>@payment.PaymentProcessorReference</td>
                            <td>@payment.Status</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <h3>Online payment attempts</h3>
        @if (_patientPayments is null)
        {
            <p>Loading…</p>
        }
        else if (_patientPayments.Count == 0)
        {
            <p>No online payment attempts.</p>
        }
        else
        {
            <table>
                <thead><tr><th>Attempted</th><th>Amount</th><th>Status</th></tr></thead>
                <tbody>
                    @foreach (var attempt in _patientPayments)
                    {
                        <tr>
                            <td>@attempt.AttemptedAt.ToString("yyyy-MM-dd h:mm tt")</td>
                            <td>@attempt.Amount.ToString("C")</td>
                            <td>@attempt.Status</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <section>
        <h2>Superbills (cash-pay)</h2>
        @if (CanBill)
        {
            <button class="primary" @onclick="() => _showSuperbillForm = !_showSuperbillForm">@(_showSuperbillForm ? "Cancel" : "New superbill")</button>
            @if (_showSuperbillForm)
            {
                <div class="form-card">
                    @if (_superbillError is not null)
                    {
                        <p class="error">@_superbillError</p>
                    }
                    <label>
                        Rendering clinician
                        <select @bind="_newSuperbillClinicianId">
                            <option value="">Select provider…</option>
                            @foreach (var provider in _providerOptions)
                            {
                                <option value="@provider.Id">@provider.FullName</option>
                            }
                        </select>
                    </label>
                    <label>Service date <input type="date" @bind="_newSuperbillServiceDate" /></label>
                    <label>Codes (comma-separated) <input @bind="_newSuperbillCodes" placeholder="97110, 97140" /></label>
                    <label>Amount <input type="number" min="0" step="0.01" @bind="_newSuperbillAmount" /></label>
                    <button class="primary" @onclick="CreateSuperbill">Save</button>
                </div>
            }
        }
        @if (_superbills is null)
        {
            <p>Loading…</p>
        }
        else if (_superbills.Count == 0)
        {
            <p>No superbills yet.</p>
        }
        else
        {
            <table>
                <thead><tr><th>Service date</th><th>Codes</th><th>Amount</th><th>Status</th></tr></thead>
                <tbody>
                    @foreach (var superbill in _superbills)
                    {
                        <tr>
                            <td>@superbill.ServiceDate.ToString("yyyy-MM-dd")</td>
                            <td>@string.Join(", ", superbill.Codes)</td>
                            <td>@superbill.Amount.ToString("C")</td>
                            <td>@superbill.Status</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <section>
        <h2>Statements</h2>
        @if (CanBill)
        {
            <div class="inline-form">
                <input type="date" @bind="_newStatementDueDate" />
                <button class="primary" @onclick="GenerateStatement">Generate statement</button>
            </div>
            @if (_statementError is not null)
            {
                <p class="error">@_statementError</p>
            }
        }
        @if (_statements is null)
        {
            <p>Loading…</p>
        }
        else if (_statements.Count == 0)
        {
            <p>No statements generated yet.</p>
        }
        else
        {
            <table>
                <thead><tr><th>Statement date</th><th>Due date</th><th>Balance at generation</th></tr></thead>
                <tbody>
                    @foreach (var statement in _statements)
                    {
                        <tr>
                            <td>@statement.StatementDate.ToString("yyyy-MM-dd")</td>
                            <td>@statement.DueDate.ToString("yyyy-MM-dd")</td>
                            <td>@statement.BalanceAtGeneration.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
}

<style>
    dl { display: grid; grid-template-columns: 160px 1fr; row-gap: 0.5rem; max-width: 480px; }
    dt { font-weight: 600; color: #475569; }
    .error { color: #dc2626; }
    section { margin-top: 2rem; }
    table { width: 100%; border-collapse: collapse; margin-top: 0.75rem; }
    th, td { text-align: left; padding: 0.5rem 0.75rem; border-bottom: 1px solid #e2e8f0; }
    button.primary { background: #2563eb; color: white; border: none; border-radius: 4px; padding: 0.5rem 1rem; cursor: pointer; }
    .inline-form { display: flex; gap: 0.5rem; align-items: center; margin-bottom: 0.5rem; }
    .form-card { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px; padding: 1rem; margin-top: 0.75rem; max-width: 420px; }
    .form-card label { display: block; margin-bottom: 0.75rem; font-size: 0.9rem; }
    .form-card input, .form-card select { width: 100%; padding: 0.4rem; margin-top: 0.25rem; box-sizing: border-box; }
</style>

@code {
    [Parameter]
    public Guid PatientId { get; set; }

    private Patient? _patient;
    private string? _error;

    private List<ClinicalNote>? _notes;
    private NoteType _newNoteType = NoteType.Daily;
    private DateOnly _newNoteServiceDate = DateOnly.FromDateTime(DateTime.Today);
    private string? _noteError;

    private List<FunctionalGoal>? _goals;
    private bool _showGoalForm;
    private string? _goalError;
    private string _newGoalLimitation = string.Empty;
    private string _newGoalTask = string.Empty;
    private decimal _newGoalBaseline;
    private decimal _newGoalTarget;
    private string _newGoalUnit = string.Empty;
    private string _newGoalMethod = string.Empty;
    private DateOnly _newGoalTargetDate = DateOnly.FromDateTime(DateTime.Today.AddMonths(1));
    private readonly Dictionary<Guid, string?> _goalProgressEdits = new();

    private List<OutcomeScore>? _outcomes;
    private bool _showOutcomeForm;
    private string? _outcomeError;
    private OutcomeMeasure _newOutcomeMeasure = OutcomeMeasure.Lefs;
    private DateOnly _newOutcomeDate = DateOnly.FromDateTime(DateTime.Today);
    private decimal _newOutcomeScore;
    private decimal? _newOutcomeMax;

    private List<PatientInsurance>? _insurancePolicies;
    private List<Payer> _payerOptions = new();
    private Dictionary<Guid, string> _payerNamesById = new();
    private bool _showInsuranceForm;
    private string? _insuranceError;
    private Guid? _newInsurancePayerId;
    private InsuranceRank _newInsuranceRank = InsuranceRank.Primary;
    private string _newInsuranceMemberId = string.Empty;
    private string? _newInsuranceGroupNumber;
    private DateOnly _newInsuranceEffectiveDate = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly? _newInsuranceTerminationDate;
    private decimal? _newInsuranceCopay;

    private List<Charge>? _charges;
    private List<Provider> _providerOptions = new();
    private bool _showChargeForm;
    private string? _chargeError;
    private string _newChargeCptCode = string.Empty;
    private Guid? _newChargeProviderId;
    private Guid? _newChargeNoteId;
    private DateOnly _newChargeServiceDate = DateOnly.FromDateTime(DateTime.Today);
    private int _newChargeUnits = 1;
    private int? _newChargeMinutes;
    private string? _newChargeOverrideReason;
    private decimal _newChargeAmount;

    private List<Claim>? _claims;
    private bool _showClaimForm;
    private string? _claimError;
    private Guid? _newClaimInsuranceId;
    private readonly HashSet<Guid> _selectedChargeIds = new();

    private List<PaymentRecord>? _paymentRecords;
    private List<PatientPayment>? _patientPayments;
    private bool _showPaymentForm;
    private string? _paymentError;
    private decimal _newPaymentAmount;
    private DateOnly _newPaymentReceivedOn = DateOnly.FromDateTime(DateTime.Today);
    private string _newPaymentReference = string.Empty;
    private Guid? _newPaymentSuperbillId;

    private List<Superbill>? _superbills;
    private bool _showSuperbillForm;
    private string? _superbillError;
    private Guid? _newSuperbillClinicianId;
    private DateOnly _newSuperbillServiceDate = DateOnly.FromDateTime(DateTime.Today);
    private string _newSuperbillCodes = string.Empty;
    private decimal _newSuperbillAmount;

    private List<PatientStatement>? _statements;
    private string? _statementError;
    private DateOnly _newStatementDueDate = DateOnly.FromDateTime(DateTime.Today.AddDays(30));

    private bool CanDocument => RoleSets.Clinical.Contains(CurrentUser.Role);
    private bool CanApproveGoals => CurrentUser.Role is UserRole.Admin or UserRole.Director or UserRole.Therapist;
    private bool CanBill => RoleSets.Billing.Contains(CurrentUser.Role);
    private bool CanCollectPayments => RoleSets.PaymentCollection.Contains(CurrentUser.Role);
    private List<Charge> UnbilledCharges => (_charges ?? new()).Where(c => c.ClaimId is null && c.SuperbillId is null && c.Status != ChargeStatus.Void).ToList();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _patient = await TenantAccess.RequirePatientAccessAsync(CurrentUser, PatientId);
        }
        catch (PhysioTrac.Application.Common.ForbiddenException ex)
        {
            _error = ex.Message;
            return;
        }

        await ReloadNotesAsync();
        await ReloadGoalsAsync();
        await ReloadOutcomesAsync();
        await ReloadInsuranceAsync();
        await ReloadChargesAsync();
        await ReloadClaimsAsync();
        await ReloadPaymentsAsync();
        await ReloadSuperbillsAsync();
        await ReloadStatementsAsync();
    }

    private async Task ReloadNotesAsync() =>
        _notes = (await NoteService.ListForPatientAsync(PatientId, CurrentUser)).ToList();

    private async Task ReloadGoalsAsync() =>
        _goals = (await GoalService.ListForPatientAsync(PatientId, CurrentUser)).ToList();

    private async Task ReloadOutcomesAsync() =>
        _outcomes = (await OutcomeService.ListForPatientAsync(PatientId, CurrentUser)).ToList();

    private async Task StartNote()
    {
        _noteError = null;
        try
        {
            var request = new CreateNoteRequest(PatientId, _newNoteType, _newNoteServiceDate, null,
                null, null, null, null, null, null, null, null, null, null);
            var note = await NoteService.CreateDraftAsync(request, CurrentUser);
            Navigation.NavigateTo($"/notes/{note.Id}");
        }
        catch (PhysioTrac.Application.Common.ForbiddenException ex) { _noteError = ex.Message; }
        catch (PhysioTrac.Application.Common.NotFoundException ex) { _noteError = ex.Message; }
    }

    private async Task CreateGoal()
    {
        _goalError = null;
        if (string.IsNullOrWhiteSpace(_newGoalLimitation) || string.IsNullOrWhiteSpace(_newGoalTask)
            || string.IsNullOrWhiteSpace(_newGoalUnit) || string.IsNullOrWhiteSpace(_newGoalMethod))
        {
            _goalError = "All fields except suggested wording are required.";
            return;
        }

        try
        {
            var request = new CreateGoalRequest(PatientId, _newGoalLimitation.Trim(), _newGoalTask.Trim(),
                _newGoalBaseline, _newGoalTarget, _newGoalUnit.Trim(), _newGoalMethod.Trim(), _newGoalTargetDate, null);
            await GoalService.CreateAsync(request, CurrentUser);
        }
        catch (PhysioTrac.Application.Common.ForbiddenException ex) { _goalError = ex.Message; return; }

        _newGoalLimitation = string.Empty;
        _newGoalTask = string.Empty;
        _newGoalBaseline = 0;
        _newGoalTarget = 0;
        _newGoalUnit = string.Empty;
        _newGoalMethod = string.Empty;
        _newGoalTargetDate = DateOnly.FromDateTime(DateTime.Today.AddMonths(1));
        _showGoalForm = false;
        await ReloadGoalsAsync();
    }

    private async Task ApproveGoal(Guid goalId)
    {
        try
        {
            await GoalService.ApproveAsync(goalId, CurrentUser);
        }
        catch (Exception ex) when (ex is PhysioTrac.Application.Common.ForbiddenException or InvalidOperationException)
        {
            _goalError = ex.Message;
            return;
        }
        await ReloadGoalsAsync();
    }

    private string GoalProgressInput(Guid goalId, decimal? currentValue) =>
        _goalProgressEdits.TryGetValue(goalId, out var edited) && edited is not null ? edited : currentValue?.ToString() ?? string.Empty;

    private async Task UpdateGoalProgress(Guid goalId)
    {
        if (!_goalProgressEdits.TryGetValue(goalId, out var raw) || !decimal.TryParse(raw, out var value))
        {
            return;
        }

        try
        {
            await GoalService.UpdateProgressAsync(goalId, new UpdateGoalProgressRequest(value), CurrentUser);
        }
        catch (PhysioTrac.Application.Common.ForbiddenException ex) { _goalError = ex.Message; return; }

        await ReloadGoalsAsync();
    }

    private async Task RecordOutcome()
    {
        _outcomeError = null;
        try
        {
            var request = new RecordOutcomeScoreRequest(PatientId, null, _newOutcomeMeasure, _newOutcomeDate, _newOutcomeScore, _newOutcomeMax, null);
            await OutcomeService.RecordAsync(request, CurrentUser);
        }
        catch (Exception ex) when (ex is PhysioTrac.Application.Common.ForbiddenException or InvalidOperationException)
        {
            _outcomeError = ex.Message;
            return;
        }

        _newOutcomeScore = 0;
        _newOutcomeMax = null;
        _showOutcomeForm = false;
        await ReloadOutcomesAsync();
    }

    private async Task ReloadInsuranceAsync()
    {
        var organizationId = _patient!.OrganizationId;
        _insurancePolicies = await Db.PatientInsurancePolicies.Where(i => i.PatientId == PatientId)
            .OrderBy(i => i.Rank).ThenByDescending(i => i.EffectiveDate).ToListAsync();
        var payers = await Db.Payers.Where(p => p.OrganizationId == organizationId).OrderBy(p => p.Name).ToListAsync();
        _payerNamesById = payers.ToDictionary(p => p.Id, p => p.Name);
        if (CanBill) _payerOptions = payers;
    }

    private string PayerName(Guid payerId) => _payerNamesById.TryGetValue(payerId, out var name) ? name : "Unknown payer";

    private async Task CreateInsurance()
    {
        _insuranceError = null;
        if (_newInsurancePayerId is null || string.IsNullOrWhiteSpace(_newInsuranceMemberId))
        {
            _insuranceError = "Payer and member ID are required.";
            return;
        }
        if (_newInsuranceTerminationDate is DateOnly termination && termination < _newInsuranceEffectiveDate)
        {
            _insuranceError = "Termination date cannot be before the effective date.";
            return;
        }

        try
        {
            TenantAccess.RequireRole(CurrentUser, RoleSets.Billing);
        }
        catch (PhysioTrac.Application.Common.ForbiddenException ex) { _insuranceError = ex.Message; return; }

        var policy = new PatientInsurance
        {
            OrganizationId = _patient!.OrganizationId,
            PatientId = PatientId,
            PayerId = _newInsurancePayerId.Value,
            Rank = _newInsuranceRank,
            MemberId = _newInsuranceMemberId.Trim(),
            GroupNumber = string.IsNullOrWhiteSpace(_newInsuranceGroupNumber) ? null : _newInsuranceGroupNumber.Trim(),
            EffectiveDate = _newInsuranceEffectiveDate,
            TerminationDate = _newInsuranceTerminationDate,
            Copay = _newInsuranceCopay,
            CreatedById = CurrentUser.UserId,
        };
        Db.PatientInsurancePolicies.Add(policy);
        await Db.SaveChangesAsync();

        _newInsurancePayerId = null;
        _newInsuranceMemberId = string.Empty;
        _newInsuranceGroupNumber = null;
        _newInsuranceEffectiveDate = DateOnly.FromDateTime(DateTime.Today);
        _newInsuranceTerminationDate = null;
        _newInsuranceCopay = null;
        _showInsuranceForm = false;
        await ReloadInsuranceAsync();
    }

    private async Task ReloadChargesAsync()
    {
        _charges = (await ChargeService.ListForPatientAsync(PatientId, CurrentUser)).ToList();
        if (CanBill)
        {
            _providerOptions = await Db.Providers.Where(p => p.OrganizationId == _patient!.OrganizationId && p.IsActive)
                .OrderBy(p => p.LastName).ThenBy(p => p.FirstName).ToListAsync();
        }
    }

    private void ToggleChargeForm() => _showChargeForm = !_showChargeForm;

    private async Task CreateCharge()
    {
        _chargeError = null;
        if (string.IsNullOrWhiteSpace(_newChargeCptCode) || _newChargeProviderId is null)
        {
            _chargeError = "CPT code and rendering provider are required.";
            return;
        }

        var request = new CreateChargeRequest(
            PatientId, _newChargeNoteId, _newChargeProviderId.Value, null,
            _newChargeServiceDate, _newChargeCptCode.Trim().ToUpperInvariant(), null, _newChargeUnits, _newChargeMinutes,
            string.IsNullOrWhiteSpace(_newChargeOverrideReason) ? null : _newChargeOverrideReason.Trim(), _newChargeAmount, null);

        try
        {
            await ChargeService.CreateAsync(request, CurrentUser);
        }
        catch (Exception ex) when (ex is PhysioTrac.Application.Common.ForbiddenException
            or PhysioTrac.Application.Common.NotFoundException or InvalidOperationException)
        {
            _chargeError = ex.Message;
            return;
        }

        _newChargeCptCode = string.Empty;
        _newChargeProviderId = null;
        _newChargeNoteId = null;
        _newChargeServiceDate = DateOnly.FromDateTime(DateTime.Today);
        _newChargeUnits = 1;
        _newChargeMinutes = null;
        _newChargeOverrideReason = null;
        _newChargeAmount = 0;
        _showChargeForm = false;
        await ReloadChargesAsync();
    }

    private async Task ReloadClaimsAsync() =>
        _claims = (await ClaimServiceApi.ListForPatientAsync(PatientId, CurrentUser)).ToList();

    private void ToggleClaimForm() => _showClaimForm = !_showClaimForm;

    private void ToggleChargeSelection(Guid chargeId, bool selected)
    {
        if (selected) _selectedChargeIds.Add(chargeId);
        else _selectedChargeIds.Remove(chargeId);
    }

    private async Task CreateClaim()
    {
        _claimError = null;
        if (_newClaimInsuranceId is null)
        {
            _claimError = "Select an insurance policy.";
            return;
        }
        if (_selectedChargeIds.Count == 0)
        {
            _claimError = "Select at least one unbilled charge.";
            return;
        }

        var request = new CreateClaimRequest(PatientId, _newClaimInsuranceId.Value, _selectedChargeIds.ToList());
        try
        {
            await ClaimServiceApi.CreateFromChargesAsync(request, CurrentUser);
        }
        catch (Exception ex) when (ex is PhysioTrac.Application.Common.ForbiddenException
            or PhysioTrac.Application.Common.NotFoundException or InvalidOperationException)
        {
            _claimError = ex.Message;
            return;
        }

        _newClaimInsuranceId = null;
        _selectedChargeIds.Clear();
        _showClaimForm = false;
        await ReloadChargesAsync();
        await ReloadClaimsAsync();
    }

    private async Task ReloadPaymentsAsync()
    {
        _paymentRecords = await Db.PaymentRecords.Where(p => p.PatientId == PatientId)
            .OrderByDescending(p => p.ReceivedOn).ToListAsync();
        _patientPayments = await Db.PatientPayments.Where(p => p.PatientId == PatientId)
            .OrderByDescending(p => p.AttemptedAt).ToListAsync();
    }

    private async Task CreatePaymentRecord()
    {
        _paymentError = null;
        try
        {
            TenantAccess.RequireRole(CurrentUser, RoleSets.PaymentCollection);
        }
        catch (PhysioTrac.Application.Common.ForbiddenException ex) { _paymentError = ex.Message; return; }

        if (_newPaymentAmount <= 0)
        {
            _paymentError = "Enter an amount greater than zero.";
            return;
        }
        if (_newPaymentSuperbillId is Guid superbillId && !(_superbills ?? new()).Any(s => s.Id == superbillId))
        {
            _paymentError = "A payment can only be linked to this patient's superbill.";
            return;
        }

        var payment = new PaymentRecord
        {
            PatientId = PatientId,
            SuperbillId = _newPaymentSuperbillId,
            RecordedById = CurrentUser.UserId,
            Amount = _newPaymentAmount,
            ReceivedOn = _newPaymentReceivedOn,
            PaymentProcessorReference = _newPaymentReference.Trim(),
        };
        Db.PaymentRecords.Add(payment);
        await Db.SaveChangesAsync();

        _newPaymentAmount = 0;
        _newPaymentReceivedOn = DateOnly.FromDateTime(DateTime.Today);
        _newPaymentReference = string.Empty;
        _newPaymentSuperbillId = null;
        _showPaymentForm = false;
        await ReloadPaymentsAsync();
    }

    private async Task ReloadSuperbillsAsync()
    {
        _superbills = await Db.Superbills.Where(s => s.PatientId == PatientId)
            .OrderByDescending(s => s.ServiceDate).ToListAsync();
    }

    private async Task CreateSuperbill()
    {
        _superbillError = null;
        try
        {
            TenantAccess.RequireRole(CurrentUser, RoleSets.Billing);
        }
        catch (PhysioTrac.Application.Common.ForbiddenException ex) { _superbillError = ex.Message; return; }

        if (_newSuperbillClinicianId is null)
        {
            _superbillError = "Select the rendering clinician.";
            return;
        }

        var codes = _newSuperbillCodes.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
        var superbill = new Superbill
        {
            PatientId = PatientId,
            ClinicianId = _newSuperbillClinicianId.Value,
            ServiceDate = _newSuperbillServiceDate,
            Codes = codes,
            Amount = _newSuperbillAmount,
        };
        Db.Superbills.Add(superbill);
        await Db.SaveChangesAsync();

        _newSuperbillClinicianId = null;
        _newSuperbillServiceDate = DateOnly.FromDateTime(DateTime.Today);
        _newSuperbillCodes = string.Empty;
        _newSuperbillAmount = 0;
        _showSuperbillForm = false;
        await ReloadSuperbillsAsync();
    }

    private async Task ReloadStatementsAsync()
    {
        _statements = await Db.PatientStatements.Where(s => s.PatientId == PatientId)
            .OrderByDescending(s => s.StatementDate).ToListAsync();
    }

    private async Task GenerateStatement()
    {
        _statementError = null;
        try
        {
            TenantAccess.RequireRole(CurrentUser, RoleSets.Billing);
        }
        catch (PhysioTrac.Application.Common.ForbiddenException ex) { _statementError = ex.Message; return; }

        var patientClaims = await ClaimServiceApi.ListForPatientAsync(PatientId, CurrentUser);
        decimal balance = 0;
        foreach (var claim in patientClaims)
        {
            var totals = await ClaimServiceApi.GetTotalsAsync(claim.Id, CurrentUser);
            balance += totals.Balance;
        }

        var statement = new PatientStatement
        {
            OrganizationId = _patient!.OrganizationId,
            PatientId = PatientId,
            DueDate = _newStatementDueDate,
            BalanceAtGeneration = balance,
            GeneratedById = CurrentUser.UserId,
        };
        Db.PatientStatements.Add(statement);
        await Db.SaveChangesAsync();

        await ReloadStatementsAsync();
    }
}
