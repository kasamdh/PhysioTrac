@page "/payers"
@attribute [Authorize]
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using PhysioTrac.Application.Auth
@using PhysioTrac.Application.Tenancy
@using PhysioTrac.Domain.Entities
@using PhysioTrac.Infrastructure.Persistence
@inject ICurrentUser CurrentUser
@inject ITenantAccessService TenantAccess
@inject PhysioTracDbContext Db

<PageTitle>Payers — PhysioTrac</PageTitle>

<h1 class="mb-4 text-xl font-semibold text-text">Insurance payers</h1>

@if (_error is not null)
{
    <p class="alert-error">@_error</p>
}
else if (_payers is null)
{
    <p class="text-text-muted">Loading…</p>
}
else
{
    <div class="card">
        @if (CanManage)
        {
            <button class="btn-primary mb-4" @onclick="() => _showForm = !_showForm">@(_showForm ? "Cancel" : "New payer")</button>

            @if (_showForm)
            {
                <div class="mb-4 max-w-md rounded-lg border border-border bg-surface-muted p-4">
                    @if (_formError is not null)
                    {
                        <p class="alert-error mb-3">@_formError</p>
                    }
                    <label class="field-label">Name <input @bind="_name" class="field-input" /></label>
                    <label class="field-label">Payer ID (optional) <input @bind="_payerId" class="field-input" /></label>
                    <label class="field-label">Electronic payer ID (optional) <input @bind="_electronicPayerId" class="field-input" /></label>
                    <label class="field-label">Timely filing days <input type="number" min="1" @bind="_timelyFilingDays" class="field-input" /></label>
                    <label class="mb-3 flex items-center gap-2 text-sm">
                        <input type="checkbox" @bind="_authorizationRequired" />
                        Authorization required
                    </label>
                    <label class="field-label">Authorization notes (optional) <input @bind="_authorizationNotes" class="field-input" /></label>
                    <label class="field-label">Notes (optional) <input @bind="_notes" class="field-input" /></label>
                    <button class="btn-primary" @onclick="CreatePayer">Save</button>
                </div>
            }
        }

        @if (_payers.Count == 0)
        {
            <p class="text-text-muted">No payers yet.</p>
        }
        else
        {
            <div class="overflow-hidden rounded-lg border border-border">
                <table class="data-table">
                    <thead>
                        <tr><th>Name</th><th>Payer ID</th><th>Timely filing</th><th>Auth required</th><th>Active</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var payer in _payers)
                        {
                            <tr>
                                <td>@payer.Name</td>
                                <td>@(payer.PayerId ?? "—")</td>
                                <td>@payer.TimelyFilingDays days</td>
                                <td>@(payer.AuthorizationRequired ? "Yes" : "No")</td>
                                <td><StatusPill Text="@(payer.IsActive ? "Active" : "Inactive")" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@code {
    private List<Payer>? _payers;
    private string? _error;
    private string? _formError;
    private bool _showForm;
    private Guid _organizationId;

    private string _name = string.Empty;
    private string? _payerId;
    private string? _electronicPayerId;
    private int _timelyFilingDays = 90;
    private bool _authorizationRequired;
    private string? _authorizationNotes;
    private string? _notes;

    private bool CanManage => RoleSets.Billing.Contains(CurrentUser.Role);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            var organization = await TenantAccess.OrganizationRequiredAsync(CurrentUser);
            _organizationId = organization.Id;
            _payers = await Db.Payers.Where(p => p.OrganizationId == organization.Id)
                .OrderBy(p => p.Name).ToListAsync();
        }
        catch (PhysioTrac.Application.Common.ForbiddenException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task CreatePayer()
    {
        _formError = null;
        try
        {
            TenantAccess.RequireRole(CurrentUser, RoleSets.Billing);
        }
        catch (PhysioTrac.Application.Common.ForbiddenException ex)
        {
            _formError = ex.Message;
            return;
        }

        if (string.IsNullOrWhiteSpace(_name))
        {
            _formError = "Name is required.";
            return;
        }

        var payer = new Payer
        {
            OrganizationId = _organizationId,
            Name = _name.Trim(),
            PayerId = string.IsNullOrWhiteSpace(_payerId) ? null : _payerId.Trim(),
            ElectronicPayerId = string.IsNullOrWhiteSpace(_electronicPayerId) ? null : _electronicPayerId.Trim(),
            TimelyFilingDays = _timelyFilingDays <= 0 ? 90 : _timelyFilingDays,
            AuthorizationRequired = _authorizationRequired,
            AuthorizationNotes = string.IsNullOrWhiteSpace(_authorizationNotes) ? null : _authorizationNotes.Trim(),
            Notes = string.IsNullOrWhiteSpace(_notes) ? null : _notes.Trim(),
            CreatedById = CurrentUser.UserId,
        };
        Db.Payers.Add(payer);
        await Db.SaveChangesAsync();

        _name = string.Empty;
        _payerId = null;
        _electronicPayerId = null;
        _timelyFilingDays = 90;
        _authorizationRequired = false;
        _authorizationNotes = null;
        _notes = null;
        _showForm = false;
        await LoadAsync();
    }
}
