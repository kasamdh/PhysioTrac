@page "/appointment-types"
@attribute [Authorize]
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using PhysioTrac.Application.Auth
@using PhysioTrac.Application.Tenancy
@using PhysioTrac.Domain.Entities
@using PhysioTrac.Infrastructure.Persistence
@inject ICurrentUser CurrentUser
@inject ITenantAccessService TenantAccess
@inject PhysioTracDbContext Db

<PageTitle>Appointment types — PhysioTrac</PageTitle>

<h1 class="mb-4 text-xl font-semibold text-text">Appointment types</h1>

@if (_error is not null)
{
    <p class="alert-error">@_error</p>
}
else if (_types is null)
{
    <p class="text-text-muted">Loading…</p>
}
else
{
    <div class="card">
        @if (CanManage)
        {
            <button class="btn-primary mb-4" @onclick="() => _showForm = !_showForm">@(_showForm ? "Cancel" : "New appointment type")</button>

            @if (_showForm)
            {
                <div class="mb-4 max-w-md rounded-lg border border-border bg-surface-muted p-4">
                    @if (_formError is not null)
                    {
                        <p class="alert-error mb-3">@_formError</p>
                    }
                    <label class="field-label">Name <input @bind="_name" class="field-input" /></label>
                    <label class="field-label">Description <input @bind="_description" class="field-input" /></label>
                    <label class="field-label">Default duration (minutes) <input type="number" min="5" step="5" @bind="_durationMinutes" class="field-input" /></label>
                    <label class="field-label">Price <input type="number" min="0" step="0.01" @bind="_price" class="field-input" /></label>
                    <label class="mb-3 flex items-center gap-2 text-sm">
                        <input type="checkbox" @bind="_onlineBookingEnabled" />
                        Online booking enabled
                    </label>
                    <label class="mb-3 flex items-center gap-2 text-sm">
                        <input type="checkbox" @bind="_requiresNewPatient" />
                        Requires new patient (e.g. Initial Evaluation)
                    </label>
                    <button class="btn-primary" @onclick="CreateType">Save</button>
                </div>
            }
        }

        @if (_types.Count == 0)
        {
            <p class="text-text-muted">No appointment types yet.</p>
        }
        else
        {
            <div class="overflow-hidden rounded-lg border border-border">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Duration</th>
                            <th>Price</th>
                            <th>Active</th>
                            <th>Online booking</th>
                            <th>New patient only</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var type in _types)
                        {
                            <tr>
                                <td>@type.Name</td>
                                <td>@type.DefaultDurationMinutes min</td>
                                <td>@(type.Price is { } price ? price.ToString("C") : "—")</td>
                                <td><StatusPill Text="@(type.IsActive ? "Active" : "Inactive")" /></td>
                                <td>@(type.OnlineBookingEnabled ? "Yes" : "No")</td>
                                <td>@(type.RequiresNewPatient ? "Yes" : "No")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@code {
    private List<AppointmentType>? _types;
    private string? _error;
    private string? _formError;
    private bool _showForm;
    private Guid _organizationId;

    private string _name = string.Empty;
    private string? _description;
    private int _durationMinutes = 30;
    private decimal? _price;
    private bool _onlineBookingEnabled = true;
    private bool _requiresNewPatient;

    private bool CanManage => RoleSets.Scheduling.Contains(CurrentUser.Role);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            var organization = await TenantAccess.OrganizationRequiredAsync(CurrentUser);
            _organizationId = organization.Id;
            _types = await Db.AppointmentTypes.Where(a => a.OrganizationId == organization.Id)
                .OrderBy(a => a.Name)
                .ToListAsync();
        }
        catch (PhysioTrac.Application.Common.ForbiddenException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task CreateType()
    {
        _formError = null;
        try
        {
            TenantAccess.RequireRole(CurrentUser, RoleSets.Scheduling);
        }
        catch (PhysioTrac.Application.Common.ForbiddenException ex)
        {
            _formError = ex.Message;
            return;
        }

        if (string.IsNullOrWhiteSpace(_name))
        {
            _formError = "Name is required.";
            return;
        }
        if (_durationMinutes <= 0)
        {
            _formError = "Duration must be greater than zero.";
            return;
        }

        var type = new AppointmentType
        {
            OrganizationId = _organizationId,
            Name = _name.Trim(),
            Description = string.IsNullOrWhiteSpace(_description) ? null : _description.Trim(),
            DefaultDurationMinutes = _durationMinutes,
            Price = _price,
            OnlineBookingEnabled = _onlineBookingEnabled,
            RequiresNewPatient = _requiresNewPatient,
        };
        Db.AppointmentTypes.Add(type);
        await Db.SaveChangesAsync();

        _name = string.Empty;
        _description = null;
        _durationMinutes = 30;
        _price = null;
        _onlineBookingEnabled = true;
        _requiresNewPatient = false;
        _showForm = false;
        await LoadAsync();
    }
}
