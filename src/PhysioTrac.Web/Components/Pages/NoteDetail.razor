@page "/notes/{NoteId:guid}"
@attribute [Authorize]
@rendermode InteractiveServer
@using PhysioTrac.Application.Auth
@using PhysioTrac.Application.Clinical
@using PhysioTrac.Domain.Entities
@using PhysioTrac.Domain.Enums
@inject ICurrentUser CurrentUser
@inject IClinicalNoteService NoteService
@inject NavigationManager Navigation

<PageTitle>Clinical note — PhysioTrac</PageTitle>

@if (_error is not null)
{
    <p class="alert-error">@_error</p>
}
else if (_note is null)
{
    <p class="text-text-muted">Loading…</p>
}
else
{
    <a href="/patients/@_note.PatientId" class="text-sm text-text-muted no-underline hover:text-primary">&larr; Back to patient</a>

    <div class="card mt-3">
        <div class="flex flex-wrap items-center justify-between gap-2">
            <h1 class="text-xl font-semibold text-text">@_note.NoteType note — @_note.ServiceDate.ToString("yyyy-MM-dd")</h1>
            <StatusPill Text="@_note.Status.ToString()" />
        </div>
        <p class="mt-1 text-sm text-text-muted">
            @if (_note.IsSigned)
            {
                <span>Signed by @_note.SignatureName on @_note.SignedAt?.ToString("yyyy-MM-dd h:mm tt")</span>
            }
            @if (_note.CosignedAt is not null)
            {
                <span> · Cosigned @_note.CosignedAt?.ToString("yyyy-MM-dd h:mm tt")</span>
            }
        </p>
    </div>

    @if (_findings.Count > 0)
    {
        <div class="mt-4 rounded-lg border border-warning-light bg-warning-light/40 p-4">
            <h3 class="mb-2 text-sm font-semibold text-text">Documentation checks</h3>
            <ul class="space-y-1 text-sm">
                @foreach (var finding in _findings)
                {
                    <li class="@(finding.FinalizationBlocker ? "text-danger" : "text-warning")">
                        <strong>@finding.Title</strong> — @finding.Detail
                    </li>
                }
            </ul>
        </div>
    }

    <div class="card mt-4 space-y-3">
        <label class="field-label">
            Subjective
            <textarea rows="3" disabled="@(!_canEdit)" @bind="_subjective" class="field-input disabled:bg-surface-muted"></textarea>
        </label>
        <label class="field-label">
            Objective
            <textarea rows="3" disabled="@(!_canEdit)" @bind="_objective" class="field-input disabled:bg-surface-muted"></textarea>
        </label>
        <label class="field-label">
            Interventions
            <textarea rows="3" disabled="@(!_canEdit)" @bind="_interventions" class="field-input disabled:bg-surface-muted"></textarea>
        </label>
        <label class="field-label">
            Assessment
            <textarea rows="3" disabled="@(!_canEdit)" @bind="_assessment" class="field-input disabled:bg-surface-muted"></textarea>
        </label>
        <label class="field-label">
            Plan
            <textarea rows="3" disabled="@(!_canEdit)" @bind="_plan" class="field-input disabled:bg-surface-muted"></textarea>
        </label>

        @if (_note.NoteType is NoteType.Evaluation or NoteType.Progress or NoteType.ReEvaluation)
        {
            <fieldset class="rounded-lg border border-border p-3">
                <legend class="px-1 text-sm font-semibold text-text">Plan of care</legend>
                <div class="flex flex-wrap gap-4">
                    <label class="field-label">Start <input type="date" disabled="@(!_canEdit)" @bind="_pocStart" class="field-input disabled:bg-surface-muted" /></label>
                    <label class="field-label">End <input type="date" disabled="@(!_canEdit)" @bind="_pocEnd" class="field-input disabled:bg-surface-muted" /></label>
                    <label class="field-label">Frequency per week <input type="number" min="0" disabled="@(!_canEdit)" @bind="_frequencyPerWeek" class="field-input disabled:bg-surface-muted" /></label>
                    <label class="field-label">Duration (weeks) <input type="number" min="0" disabled="@(!_canEdit)" @bind="_durationWeeks" class="field-input disabled:bg-surface-muted" /></label>
                    <label class="field-label">Reassessment due <input type="date" disabled="@(!_canEdit)" @bind="_reassessmentDue" class="field-input disabled:bg-surface-muted" /></label>
                </div>
            </fieldset>
        }

        @if (_canEdit)
        {
            @if (_saveError is not null)
            {
                <p class="alert-error">@_saveError</p>
            }
            <button class="btn-primary" @onclick="SaveDraft">Save draft</button>
        }
    </div>

    <div class="card mt-4">
        <h3 class="section-title">Treatment interventions</h3>
        @if (_interventionItems.Count == 0)
        {
            <p class="text-text-muted">No intervention line items yet.</p>
        }
        else
        {
            <div class="overflow-hidden rounded-lg border border-border">
                <table class="data-table">
                    <thead><tr><th>Description</th><th>Body region</th><th>Category</th><th>Minutes</th><th>Units</th></tr></thead>
                    <tbody>
                        @foreach (var item in _interventionItems)
                        {
                            <tr>
                                <td>@item.Description</td>
                                <td>@(item.BodyRegion ?? "—")</td>
                                <td>@(item.Category?.ToString() ?? "—")</td>
                                <td>@item.Minutes</td>
                                <td>@(item.Units?.ToString() ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="mt-2 text-sm text-text-muted">Total minutes: @_interventionItems.Sum(i => i.Minutes)</p>
        }

        @if (_canEdit)
        {
            <div class="mt-3 flex flex-wrap items-center gap-2">
                <input placeholder="Description" @bind="_newInterventionDescription" class="field-input mt-0 flex-[2]" />
                <input placeholder="Body region" @bind="_newInterventionBodyRegion" class="field-input mt-0 flex-1" />
                <select @bind="_newInterventionCategory" class="field-input mt-0 w-auto">
                    <option value="">Uncategorized</option>
                    @foreach (var category in Enum.GetValues<InterventionCategory>())
                    {
                        <option value="@category">@category</option>
                    }
                </select>
                <input type="number" min="0" placeholder="Minutes" @bind="_newInterventionMinutes" class="field-input mt-0 w-20" />
                <button class="btn-secondary" @onclick="AddIntervention">Add</button>
            </div>
        }
    </div>

    @if (_canFinalize && !_note.IsSigned)
    {
        <div class="card mt-4">
            <h3 class="section-title">Finalize note</h3>
            <label class="mb-3 flex items-center gap-2 text-sm">
                <input type="checkbox" @bind="_attestationConfirmed" />
                I confirm this note has been reviewed and is ready to sign.
            </label>
            @if (_signError is not null)
            {
                <p class="alert-error mb-3">@_signError</p>
            }
            <button class="btn-primary" @onclick="SignNote">Sign note</button>
        </div>
    }

    @if (_note.Status == NoteStatus.ReviewRequired && _canCosign)
    {
        <div class="card mt-4">
            <h3 class="section-title">Cosignature required</h3>
            <p class="mb-3 text-sm text-text-muted">This note was signed by the treating assistant and awaits a supervising cosignature.</p>
            @if (_signError is not null)
            {
                <p class="alert-error mb-3">@_signError</p>
            }
            <button class="btn-primary" @onclick="CosignNote">Cosign note</button>
        </div>
    }

    @if (_note.IsSigned)
    {
        <div class="card mt-4">
            <h3 class="section-title">Addenda</h3>
            @foreach (var addendum in _note.Addenda.OrderBy(a => a.CreatedAt))
            {
                <div class="mb-3 border-l-2 border-primary pl-3">
                    <strong>@addendum.Reason</strong> — @addendum.CreatedAt.ToString("yyyy-MM-dd h:mm tt")
                    <p class="text-sm text-text-muted">@addendum.Body</p>
                </div>
            }
            @if (_canCreateAddendum)
            {
                <div class="mt-3 max-w-md rounded-lg border border-border bg-surface-muted p-4">
                    @if (_addendumError is not null)
                    {
                        <p class="alert-error mb-3">@_addendumError</p>
                    }
                    <label class="field-label">Reason <input @bind="_newAddendumReason" class="field-input" /></label>
                    <label class="field-label">Details <textarea rows="3" @bind="_newAddendumBody" class="field-input"></textarea></label>
                    <button class="btn-primary" @onclick="AddAddendum">Add addendum</button>
                </div>
            }
        </div>
    }
}

@code {
    [Parameter]
    public Guid NoteId { get; set; }

    private ClinicalNote? _note;
    private string? _error;
    private IReadOnlyList<ComplianceFinding> _findings = Array.Empty<ComplianceFinding>();
    private List<NoteIntervention> _interventionItems = new();

    private string? _subjective;
    private string? _objective;
    private string? _interventions;
    private string? _assessment;
    private string? _plan;
    private DateOnly? _pocStart;
    private DateOnly? _pocEnd;
    private int? _frequencyPerWeek;
    private int? _durationWeeks;
    private DateOnly? _reassessmentDue;
    private string? _saveError;

    private bool _attestationConfirmed;
    private string? _signError;

    private string _newInterventionDescription = string.Empty;
    private string? _newInterventionBodyRegion;
    private InterventionCategory? _newInterventionCategory;
    private int _newInterventionMinutes;

    private string _newAddendumReason = string.Empty;
    private string _newAddendumBody = string.Empty;
    private string? _addendumError;

    private bool _canEdit;
    private bool _canFinalize;
    private bool _canCosign;
    private bool _canCreateAddendum;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _note = await NoteService.GetAsync(NoteId, CurrentUser);
        }
        catch (PhysioTrac.Application.Common.ForbiddenException ex) { _error = ex.Message; return; }
        catch (PhysioTrac.Application.Common.NotFoundException ex) { _error = ex.Message; return; }

        _canEdit = NoteService.CanEditNote(CurrentUser, _note);
        _canFinalize = NoteService.CanFinalizeNote(CurrentUser, _note);
        _canCosign = NoteService.CanCosignNote(CurrentUser, _note);
        _canCreateAddendum = NoteService.CanCreateAddendum(CurrentUser, _note);
        _findings = NoteComplianceEvaluator.Evaluate(_note);

        _subjective = _note.Subjective;
        _objective = _note.Objective;
        _interventions = _note.Interventions;
        _assessment = _note.Assessment;
        _plan = _note.Plan;
        _pocStart = _note.PlanOfCareStart;
        _pocEnd = _note.PlanOfCareEnd;
        _frequencyPerWeek = _note.FrequencyPerWeek;
        _durationWeeks = _note.DurationWeeks;
        _reassessmentDue = _note.ReassessmentDue;

        _interventionItems = (await NoteService.ListInterventionsAsync(NoteId, CurrentUser)).ToList();
    }

    private async Task SaveDraft()
    {
        _saveError = null;
        var request = new UpdateNoteRequest(_subjective, _objective, _interventions, _assessment, _plan,
            _pocStart, _pocEnd, _frequencyPerWeek, _durationWeeks, _reassessmentDue);
        try
        {
            await NoteService.UpdateDraftAsync(NoteId, request, CurrentUser);
        }
        catch (PhysioTrac.Application.Common.ForbiddenException ex) { _saveError = ex.Message; return; }
        await LoadAsync();
    }

    private async Task AddIntervention()
    {
        if (string.IsNullOrWhiteSpace(_newInterventionDescription)) return;

        var request = new CreateInterventionRequest(_newInterventionDescription.Trim(), _newInterventionBodyRegion,
            _newInterventionCategory, _newInterventionMinutes, null, true, _interventionItems.Count);
        await NoteService.AddInterventionAsync(NoteId, request, CurrentUser);

        _newInterventionDescription = string.Empty;
        _newInterventionBodyRegion = null;
        _newInterventionCategory = null;
        _newInterventionMinutes = 0;
        _interventionItems = (await NoteService.ListInterventionsAsync(NoteId, CurrentUser)).ToList();
    }

    private async Task SignNote()
    {
        _signError = null;
        try
        {
            await NoteService.SignNoteAsync(NoteId, _attestationConfirmed, CurrentUser);
        }
        catch (Exception ex) when (ex is PhysioTrac.Application.Common.ForbiddenException or InvalidOperationException)
        {
            _signError = ex.Message;
            return;
        }
        await LoadAsync();
    }

    private async Task CosignNote()
    {
        _signError = null;
        try
        {
            await NoteService.CosignNoteAsync(NoteId, CurrentUser);
        }
        catch (Exception ex) when (ex is PhysioTrac.Application.Common.ForbiddenException or InvalidOperationException)
        {
            _signError = ex.Message;
            return;
        }
        await LoadAsync();
    }

    private async Task AddAddendum()
    {
        _addendumError = null;
        if (string.IsNullOrWhiteSpace(_newAddendumReason) || string.IsNullOrWhiteSpace(_newAddendumBody))
        {
            _addendumError = "Reason and details are required.";
            return;
        }
        try
        {
            await NoteService.CreateAddendumAsync(NoteId, new CreateAddendumRequest(_newAddendumReason.Trim(), _newAddendumBody.Trim()), CurrentUser);
        }
        catch (Exception ex) when (ex is PhysioTrac.Application.Common.ForbiddenException or InvalidOperationException)
        {
            _addendumError = ex.Message;
            return;
        }

        _newAddendumReason = string.Empty;
        _newAddendumBody = string.Empty;
        await LoadAsync();
    }
}
