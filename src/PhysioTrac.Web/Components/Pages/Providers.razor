@page "/providers"
@attribute [Authorize]
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using PhysioTrac.Application.Auth
@using PhysioTrac.Application.Tenancy
@using PhysioTrac.Domain.Entities
@using PhysioTrac.Infrastructure.Persistence
@inject ICurrentUser CurrentUser
@inject ITenantAccessService TenantAccess
@inject PhysioTracDbContext Db

<PageTitle>Providers — PhysioTrac</PageTitle>

<h1 class="mb-4 text-xl font-semibold text-text">Providers</h1>

@if (_error is not null)
{
    <p class="alert-error">@_error</p>
}
else if (_providers is null)
{
    <p class="text-text-muted">Loading…</p>
}
else
{
    <div class="card">
        @if (CanManage)
        {
            <button class="btn-primary mb-4" @onclick="() => _showForm = !_showForm">@(_showForm ? "Cancel" : "New provider")</button>

            @if (_showForm)
            {
                <div class="mb-4 max-w-md rounded-lg border border-border bg-surface-muted p-4">
                    @if (_formError is not null)
                    {
                        <p class="alert-error mb-3">@_formError</p>
                    }
                    <label class="field-label">First name <input @bind="_firstName" class="field-input" /></label>
                    <label class="field-label">Last name <input @bind="_lastName" class="field-input" /></label>
                    <label class="field-label">Specialty <input @bind="_specialty" class="field-input" /></label>
                    <label class="field-label">Credentials <input @bind="_credentials" class="field-input" /></label>
                    <button class="btn-primary" @onclick="CreateProvider">Save</button>
                </div>
            }
        }

        @if (_providers.Count == 0)
        {
            <p class="text-text-muted">No providers yet.</p>
        }
        else
        {
            <div class="overflow-hidden rounded-lg border border-border">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Specialty</th>
                            <th>Credentials</th>
                            <th>Active</th>
                            <th>Online booking</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var provider in _providers)
                        {
                            <tr>
                                <td>@provider.FullName</td>
                                <td>@(provider.Specialty ?? "—")</td>
                                <td>@(provider.Credentials ?? "—")</td>
                                <td><StatusPill Text="@(provider.IsActive ? "Active" : "Inactive")" /></td>
                                <td>@(provider.OnlineBookingEnabled ? "Yes" : "No")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@code {
    private List<Provider>? _providers;
    private string? _error;
    private string? _formError;
    private bool _showForm;
    private Guid _organizationId;

    private string _firstName = string.Empty;
    private string _lastName = string.Empty;
    private string? _specialty;
    private string? _credentials;

    private bool CanManage => RoleSets.Scheduling.Contains(CurrentUser.Role);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            var organization = await TenantAccess.OrganizationRequiredAsync(CurrentUser);
            _organizationId = organization.Id;
            _providers = await Db.Providers.Where(p => p.OrganizationId == organization.Id)
                .OrderBy(p => p.LastName).ThenBy(p => p.FirstName)
                .ToListAsync();
        }
        catch (PhysioTrac.Application.Common.ForbiddenException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task CreateProvider()
    {
        _formError = null;
        try
        {
            TenantAccess.RequireRole(CurrentUser, RoleSets.Scheduling);
        }
        catch (PhysioTrac.Application.Common.ForbiddenException ex)
        {
            _formError = ex.Message;
            return;
        }

        if (string.IsNullOrWhiteSpace(_firstName) || string.IsNullOrWhiteSpace(_lastName))
        {
            _formError = "First and last name are required.";
            return;
        }

        var provider = new Provider
        {
            OrganizationId = _organizationId,
            FirstName = _firstName.Trim(),
            LastName = _lastName.Trim(),
            Specialty = string.IsNullOrWhiteSpace(_specialty) ? null : _specialty.Trim(),
            Credentials = string.IsNullOrWhiteSpace(_credentials) ? null : _credentials.Trim(),
        };
        Db.Providers.Add(provider);
        await Db.SaveChangesAsync();

        _firstName = string.Empty;
        _lastName = string.Empty;
        _specialty = null;
        _credentials = null;
        _showForm = false;
        await LoadAsync();
    }
}
